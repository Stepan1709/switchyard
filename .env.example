# Non-secret settings. Copy to .env (make env does it). Secrets live in deploy/secrets/dev/*.
POSTGRES_USER=switchyard
POSTGRES_DB=switchyard
RABBITMQ_USER=switchyard

# First administrator, created at startup only if no administrator exists.
# The password is the dev secret deploy/secrets/dev/admin_password.
ADMIN_EMAIL=admin@example.com

# Host ports published by compose.dev.yml
POSTGRES_PORT=5433
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
ADMINER_PORT=8080
GATEWAY_PORT=8000
API_PORT=8001
WEB_PORT=8002
MOCK_LLM_PORT=8003
WORKER_PORT=8004

# Demo / measurements: pass x-mock-* headers through the gateway; MOCK_TIME_SCALE=0 makes the mock instant.
# FORWARD_HEADER_PREFIXES=x-mock-
# MOCK_TIME_SCALE=1
