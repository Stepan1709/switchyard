# Non-secret settings. Copy to .env (make env does it). Secrets live in deploy/secrets/dev/*.
POSTGRES_USER=switchyard
POSTGRES_DB=switchyard
RABBITMQ_USER=switchyard

# First administrator, created at startup only if no administrator exists.
# The password is the dev secret deploy/secrets/dev/admin_password.
ADMIN_EMAIL=admin@example.com

# Host ports published by compose.dev.yml
POSTGRES_PORT=5433
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
ADMINER_PORT=8080
API_PORT=8001
