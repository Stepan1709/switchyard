# Production settings. deploy/prod/setup.sh copies this to deploy/prod/.env (never committed).

# Where the images come from and which version runs (deploy.sh changes the version).
IMAGE_REPO=ghcr.io/stepan1709
SWITCHYARD_VERSION=latest

# Files on the server, outside the repository.
SECRETS_DIR=/etc/switchyard/secrets
TLS_DIR=/etc/switchyard/tls

# Names used by the database, the broker and the first administrator.
POSTGRES_USER=switchyard
POSTGRES_DB=switchyard
RABBITMQ_USER=switchyard
ADMIN_EMAIL=admin@example.com
ENV=prod

# Optional services of the stack: backup (daily database dumps), tls (Let's Encrypt renewal),
# monitoring (Prometheus and Grafana, not published: use an SSH tunnel), tracing (Jaeger).
COMPOSE_PROFILES=backup
BACKUP_KEEP=7

# Set when a domain points at this server; deploy/prod/tls.sh then gets a real certificate.
DOMAIN=
ACME_EMAIL=

# Where deploy.sh leaves a dump taken before every upgrade.
PRE_DEPLOY_BACKUP_DIR=/var/backups/switchyard
